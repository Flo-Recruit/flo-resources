# Local secrets. The Airtable sync reads a personal access token from .env.local;
# this repo is public, so a token committed by accident would be exposed the
# moment it is pushed.
.env
.env.local

# decksync: HubSpot client numbers live in the private "Deck Sync Settings" artifact,
# never in this public repo; work/ is the scheduled task's scratch folder.
decksync/client_stats.json
decksync/work/
